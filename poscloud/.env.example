# MongoDB Connection URI (Atlas cluster or local MongoDB)
# Example Atlas: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/restaurant_pos?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/restaurant_pos
MONGODB_URI=mongodb://localhost:27017/restaurant_pos
MONGODB_DB=restaurant_pos

# Restaurant Details
NEXT_PUBLIC_RESTAURANT_NAME="BGS Restaurant & Lounge"
